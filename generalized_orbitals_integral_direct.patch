+    def theta_energy(self, p) -> float:
+        """<H> at circuit parameters p for the current orbitals."""
+        keys, c = self._hamiltonian_paulis()
+        self.num_energy_evals += 1
+        return float((self.estimator(keys, p) @ c).real)
